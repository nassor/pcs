// PCS cluster service configuration, built-in factories only.
// A three-node Raft cluster with at-least-once processing. Each node runs with
// its own PCS_NODE_ID and PCS_DATA_DIR.
//
// Validate, without starting a cluster:
//   PCS_NODE_ID=1 PCS_DATA_DIR=/tmp/pcs-node-1 \
//   cargo run --features service-cluster,connector-file,transformer-csv,wasm --bin pcs-service -- validate \
//     --config examples/configs/cluster.kdl
//
// Run three nodes, one per terminal or process-manager entry:
//   Terminal 1:
//     PCS_NODE_ID=1 PCS_BOOTSTRAP=true PCS_DATA_DIR=/tmp/pcs-node-1 \
//     cargo run --features service-cluster,connector-file,transformer-csv,wasm --bin pcs-service -- serve \
//       --config examples/configs/cluster.kdl
//   Terminal 2:
//     PCS_NODE_ID=2 PCS_DATA_DIR=/tmp/pcs-node-2 \
//     cargo run --features service-cluster,connector-file,transformer-csv,wasm --bin pcs-service -- serve \
//       --config examples/configs/cluster.kdl
//   Terminal 3:
//     PCS_NODE_ID=3 PCS_DATA_DIR=/tmp/pcs-node-3 \
//     cargo run --features service-cluster,connector-file,transformer-csv,wasm --bin pcs-service -- serve \
//       --config examples/configs/cluster.kdl
//
// Components and systems have no configuration representation: the processor
// declares them through `describe()`. See crates/pcs-service/src/service/registry.rs.

// Cluster mode runs the distributed Raft runner.
mode "cluster"

// True on initial bring-up with an empty data_dir, false for a node joining an
// existing cluster. The quoted form keeps the file valid KDL before
// substitution; the loader accepts a string that parses as a bool.
bootstrap "${PCS_BOOTSTRAP:-false}"

// Invariant: lease_ttl_ms >= 3 * election_timeout_ms.
// 30000 >= 3 * 1500 = 4500, so this holds.
lease_ttl_ms 30000          // 30 s
election_timeout_ms 1500    // 1.5 s
heartbeat_interval_ms 300   // 300 ms, must be < election_timeout_ms
snapshot_log_interval 10000 // snapshot every 10 000 committed log entries

// id is a u64; the quoted form accepts the substituted digits.
// PCS_NODE_ID is 1, 2, or 3, set per instance via env var.
node id="${PCS_NODE_ID}" name="pcs-node-${PCS_NODE_ID}" data_dir="${PCS_DATA_DIR:-/tmp/pcs-cluster}"

// All cluster members, including this node. IDs must match node id values, and
// each addr is the Raft transport address, not the HTTP control-plane port.
peer id=1 addr="10.0.0.1:9000"
peer id=2 addr="10.0.0.2:9000"
peer id=3 addr="10.0.0.3:9000"

// A cluster-mode workflow declares exactly one processor node and no source,
// sink or link: the distributed runner ingests through `PartitionSource` and
// drives this one runtime per node, checkpointing its output rather than
// draining it into a locally-declared sink. Build the module with
// `cargo build --release --target wasm32-wasip2`.
workflow "events" {
    wasm "process_events" module="pipelines/events.wasm"
}

// HTTP control plane; each node binds its own port.
http bind="0.0.0.0:8080" disabled=#false

// JSON output suits structured log aggregators.
observability log_format="json" log_level="${LOG_LEVEL:-info}"
