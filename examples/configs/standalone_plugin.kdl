// PCS standalone config running the native plugin fixture from
// `crates/pcs-plugin-smoketest/` under `pcs-service`.
//
// The paths below are CWD-relative, so run from the repository root:
//   cargo build -p pcs-plugin-smoketest
//   cargo run -p pcs-service --features connector-file,transformer-csv,plugin -- validate \
//     --config examples/configs/standalone_plugin.kdl --strict
//   cargo run -p pcs-service --features connector-file,transformer-csv,plugin -- serve \
//     --config examples/configs/standalone_plugin.kdl
//
// It reads examples/configs/fixtures/counter_input.csv, runs the plugin, and
// writes /tmp/pcs-counter-out.csv with `seen` filled in.
//
// A native plugin runs in-process with full host privileges and cannot be
// preempted, so `library` is an operator-trusted path. Set `sha3_256` to pin the
// exact artifact; the service refuses to start when the file's digest differs.

mode "standalone"

node id=1 name="pcs-counter-plugin" data_dir="${PCS_DATA_DIR:-/tmp/pcs-counter-plugin}"

run_mode kind="one_shot"

workflow "counter" {
    // Both FileSource and FileSink move CSV bytes, so one declared transformer
    // serves them both.
    transformer "csv_fmt" format="csv" {
        options has_headers=#true
    }

    // `component` must be "Counter": the load-time graph check compares it
    // against the component names the plugin reports from `describe`.
    source "csv_counters" type="FileSource" component="Counter" transformer="csv_fmt" {
        config {
            path "examples/configs/fixtures/counter_input.csv"
            schema_fields "id" type="Int64" nullable=#false
            schema_fields "seen" type="Int64" nullable=#false
        }
    }

    // A cdylib's file name is platform specific: libpcs_plugin_smoketest.so on
    // Linux, libpcs_plugin_smoketest.dylib on macOS, pcs_plugin_smoketest.dll on
    // Windows. Override PCS_PLUGIN_LIB to pick another one.
    plugin "process_counter" library="${PCS_PLUGIN_LIB:-target/debug/libpcs_plugin_smoketest.so}" {
        // Read by the plugin through the host's `get_config` callback. Strings;
        // the plugin parses them with `pcs_config_parse`.
        config "smoketest.multiplier"="1"
    }

    sink "csv_out" type="FileSink" component="Counter" transformer="csv_fmt" {
        config {
            path "/tmp/pcs-counter-out.csv"
            schema_fields "id" type="Int64" nullable=#false
            schema_fields "seen" type="Int64" nullable=#false
        }
    }

    link from="csv_counters" to="process_counter"
    link from="process_counter" to="csv_out"
}

http bind="127.0.0.1:0" disabled=#false

observability log_format="pretty" log_level="info"
