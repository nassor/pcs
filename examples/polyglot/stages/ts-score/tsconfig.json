// Type checking only. `jco componentize` does the transpile, so nothing here
// emits.
{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Node's type stripping never rewrites a `.js` specifier to `.ts`, so
    // `score.ts` imports `./schema_gen.ts` by its real name. The codec is a
    // bare specifier resolved through its own `exports` map, so no `paths`
    // entry is involved.
    "allowImportingTsExtensions": true,
    // Rejects enums, namespaces and parameter properties, the TypeScript
    // syntax that needs a code transform rather than an erase.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "types/**/*.d.ts"]
}
