<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-targeted tests for the wire-format codec.
       No RuntimeIdentifier: this builds for the machine, so the assertions run
       under `dotnet test` without a wasm runtime, and System.Text.Json is
       available for reading the fixture's JSON ground truth. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pcs.ArrowIpc.Tests</RootNamespace>
    <AssemblyName>ArrowIpcTests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Pcs.ArrowIpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit 2.x, which the .NET 10 SDK still runs through VSTest. The
         Microsoft Testing Platform that xunit.v3 needs is only reachable from
         `dotnet test` through a dotnet.config outside this directory. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
