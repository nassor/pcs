// Emits `dist/`, the published entry point. `allowImportingTsExtensions` is
// incompatible with emitting, so the build config turns it off and excludes the
// test that needs it.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "declaration": true,
    "outDir": "dist"
  },
  "include": ["src/*.ts"]
}
